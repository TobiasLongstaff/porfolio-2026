---
import Layout from "../layouts/Layout.astro";
import HeroTerminal from "../components/HeroTerminal.jsx";
import Projects from "../components/sections/projects.astro";
import Technologies from "../components/sections/technologies.astro";
import ExperienceTitle from "../components/sections/experience-title.astro";
import Experience from "../components/sections/experience.astro";
import Contact from "../components/sections/contact.astro";
---

<Layout>
  <main class="relative overflow-x-hidden">
    <section id="hero" data-spy class="relative z-10">
      <HeroTerminal client:load />
    </section>
    <section id="projects" data-spy class="relative z-0">
      <Projects />
    </section>
    <section id="experience-title" data-spy>
      <ExperienceTitle />
    </section>
    <section id="experience" data-spy class="scroll-mt-24 overflow-visible">
      <Experience />
    </section>
    <section id="technologies" data-spy>
      <Technologies />
    </section>
    <section id="contact" data-spy>
      <Contact />
    </section>
  </main>
</Layout>
