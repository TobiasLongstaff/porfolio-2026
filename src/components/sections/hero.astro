---
import { getCollection } from "astro:content";
import { Squares } from "../squares";
import SocialButtons from "../social-buttons.tsx";
import LocationBadge from "../location-badge.tsx";

const profile = await getCollection("profile");

// SVG de ruido codificado
const noiseSvg = `data:image/svg+xml,${encodeURIComponent(`<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg"><filter id="noiseFilter"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#noiseFilter)"/></svg>`)}`;
---

<div class="m-5 mt-0 bg-white rounded-b-3xl">
  <!-- ESTE contenedor es el que corta los blur -->
  <div
    class="relative flex items-center justify-center min-h-screen overflow-hidden rounded-b-3xl"
  >
    <!-- Squares -->
    <Squares
      client:load
      direction="diagonal"
      speed={0.2}
      borderColor="#fafafa"
      squareSize={60}
      hoverFillColor="#222"
      className="absolute inset-0 z-0"
    />
    <!-- Blurs -->
    <div class="absolute inset-0 pointer-events-none z-10">
      <div class="blur-[150px]">
        <div
          class="absolute h-[600px] w-[500px] -top-[-800px] -left-[173px] bg-[#ffd937]"
          aria-hidden="true"
        >

        </div>
        <div
          class="absolute h-[400px] w-[400px] -top-[-700px] -left-[150px] rounded-full bg-[#ff7474]"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute h-[350px] w-[350px] bottom-[-600px] right-[-200px] rounded-full bg-primary"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>

    <!-- Contenido -->
    <div class="relative z-20 flex justify-between w-full px-16">
      <div class="flex flex-col gap-[15px] w-[800px]">
        <h3 class="font-bold text-4xl">{profile[0].data.name}</h3>

        <h1 class="font-bold text-9xl tracking-[-2px] leading-[125px]">
          <span class="text-primary">Front</span><span>end</span>
          <br />
          Development.
        </h1>

        <p class="text-2xl">
          {profile[0].body}
        </p>

        <LocationBadge
          client:load
          country={profile[0].data.country}
          city={profile[0].data.city}
        />
      </div>

      <img
        src={profile[0].data.avatar}
        alt={profile[0].data.name}
        class="h-[400px]"
      />

      <div class="flex flex-col justify-end">
        <SocialButtons client:load social={profile[0].data.social} />
      </div>
    </div>
  </div>
</div>
